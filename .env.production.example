# ==============================================================================
# CPAA Production Environment Variables Template
# Copy this file to .env on your AWS EC2 instance: cp .env.production.example .env
# ==============================================================================

# Core Application Settings
SECRET_KEY=generate_a_random_32_character_secret_key_here
FRONTEND_URL=https://cpaa.ganpatikrsah.site

# Database (Neon PostgreSQL)
# Example: postgresql+asyncpg://<user>:<password>@<host>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://username:password@ep-example.aws.neon.tech/neondb?ssl=require

# Redis (Cloud Redis)
# Example: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:password@redis-host:port
SESSION_CACHE_TTL=3600

# Auth0 Authentication
# In Auth0 Dashboard -> Applications -> Your App:
# Allowed Callback URLs: https://cpaa.ganpatikrsah.site/api/auth/callback
# Allowed Logout URLs:   https://cpaa.ganpatikrsah.site
# Allowed Web Origins:   https://cpaa.ganpatikrsah.site
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_DOMAIN=your_tenant.auth0.com
AUTH0_REDIRECT_URI=https://cpaa.ganpatikrsah.site/api/auth/callback
AUTH0_REDIRECT_URL=https://cpaa.ganpatikrsah.site/api/auth/callback

# WhatsApp Meta Cloud API
# In Meta Developer Console -> WhatsApp -> Configuration:
# Webhook Callback URL: https://cpaa.ganpatikrsah.site/api/webhook
# Verify Token: (must match WHATSAPP_VERIFY_TOKEN below)
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# ==============================================================================
# AI Models & Provider Modes
# ==============================================================================
# Mode 1: AWS Bedrock Amazon Nova Pro
#   MODEL_PROVIDER=bedrock
#   MODEL_ID=apac.amazon.nova-pro-v1:0   (for ap-south-1 Mumbai / APAC)
#   MODEL_ID=amazon.nova-pro-v1:0        (for us-east-1 / us-west-2)
#
# Mode 2: Google Free Tier API
#   MODEL_PROVIDER=google
#   MODEL_ID=gemini-2.5-flash            (or gemini-1.5-flash)
# ==============================================================================
MODEL_PROVIDER=bedrock
MODEL_ID=apac.amazon.nova-pro-v1:0

# Google API (Required if MODEL_PROVIDER=google)
GEMINI_API_KEY=your_gemini_api_key

# AWS Bedrock & S3 Infrastructure (Required if MODEL_PROVIDER=bedrock or AGENT_SESSION_TYPE=s3)
# Note: If running on an AWS EC2 instance with an IAM role attached, you may leave
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty to use the IAM instance profile.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Agent Session Storage
# Options: "file" (local disk) or "s3" (AWS S3 persistence across instances)
AGENT_SESSION_TYPE=file
AGENT_SESSION_DIR=/tmp/agent_sessions
S3_SESSION_BUCKET=agent-sessions
S3_SESSION_PREFIX=whatsapp-agent/

# Mem0 AI Semantic Memory
MEM0_API_KEY=your_mem0_api_key

# Composio Workspaces Toolkits
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_MCP_SERVER_ID=
COMPOSIO_AUTH_GMAIL=
COMPOSIO_AUTH_GCAL=
COMPOSIO_AUTH_GDRIVE=
COMPOSIO_AUTH_ZOOM=
COMPOSIO_AUTH_GITHUB=
COMPOSIO_AUTH_SLACK=
COMPOSIO_AUTH_NOTION=
COMPOSIO_AUTH_LINEAR=
COMPOSIO_AUTH_TWITTER=
COMPOSIO_AUTH_TRELLO=
COMPOSIO_AUTH_SPOTIFY=
COMPOSIO_AUTH_DISCORD=
COMPOSIO_AUTH_JIRA=
